# Where the appointment form POSTs. Swap for Formspree, Netlify Forms, or a Supabase function.
# Examples:
#   PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
#   PUBLIC_FORM_ENDPOINT=https://<project>.supabase.co/functions/v1/appointment
# Leave unset to show telephone scheduling until an endpoint is configured.
PUBLIC_FORM_ENDPOINT=

# Lead inquiry delivery endpoint. Leave blank to show the form with sending disabled.
# Configure the recipient in your form provider, then rebuild after setting this URL.
PUBLIC_LEAD_FORM_ENDPOINT=
