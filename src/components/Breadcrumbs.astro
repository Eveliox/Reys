---
import type { Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';

interface Props {
  lang: Lang;
  items: { name: string; path: string }[];
}
const { lang, items } = Astro.props;
const t = useTranslations(lang);
---

<nav aria-label={t.breadcrumb.label} class="container-x pt-6 text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-muted">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? (
            <span aria-current="page" class="font-semibold text-ink">
              {item.name}
            </span>
          ) : (
            <a href={item.path} class="underline-offset-4 hover:text-ink hover:underline">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
