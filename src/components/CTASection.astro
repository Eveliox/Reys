---
import { site } from '../config/site.ts';
import { pathFor, type Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  title?: string;
  text?: string;
}
const { lang, title, text } = Astro.props;
const t = useTranslations(lang);
---

<section class="container-x pb-16 sm:pb-24" aria-labelledby="cta-title">
  <div class="flex flex-col items-start justify-between gap-6 rounded-[2rem] bg-accent p-8 text-white sm:p-12 lg:flex-row lg:items-center">
    <div>
      <h2 id="cta-title" class="text-3xl tracking-tight sm:text-4xl">{title ?? t.services.ctaTitle}</h2>
      <p class="mt-2 max-w-xl text-lg">{text ?? t.services.ctaText}</p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href={`tel:${site.phone.e164}`} class="btn bg-white text-ink hover:bg-cream">
        <Icon name="phone" />
        {site.phone.display}
      </a>
      <a href={pathFor(lang, 'book')} class="btn border-2 border-white text-white hover:bg-white hover:text-accent-dark">
        <Icon name="calendar" />
        {t.cta.book}
      </a>
    </div>
  </div>
</section>
