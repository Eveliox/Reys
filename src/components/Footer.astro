---
import { locations, services, site } from '../config/site.ts';
import { pathFor, type Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import { hoursSummary } from '../lib/format.ts';
import Icon, { type IconName } from './Icon.astro';
import LangToggle from './LangToggle.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const socials = (Object.entries(site.socials) as [IconName & keyof typeof site.socials, string][])
  .filter(([, url]) => url)
  .map(([name, url]) => ({ name, url, label: name.charAt(0).toUpperCase() + name.slice(1) }));
const year = new Date().getFullYear();
---

<footer class="tile-bg-dark bg-paper text-ink">
  <div class="container-x grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.2fr_1.3fr_1.1fr_0.9fr]">
    <div>
      <a href={pathFor(lang, 'home')} class="inline-block rounded-lg">
        <Logo />
      </a>
      <p class="mt-4 max-w-xs text-muted">{t.footer.tagline}</p>
      <p class="mt-4 flex items-center gap-2 font-bold">
        <Icon name="star" class="size-5 text-accent" />
        {site.rating.value} · {t.rating.onGoogle}
      </p>
      {socials.length > 0 && (
        <div class="mt-6">
          <h2 class="text-sm font-bold tracking-[0.14em] text-accent uppercase">
            {t.footer.follow}
          </h2>
          <ul class="mt-3 flex gap-2">
            {socials.map((s) => (
              <li>
                <a
                  href={s.url}
                  rel="noopener"
                  target="_blank"
                  class="inline-flex size-11 items-center justify-center rounded-full border border-line hover:border-accent hover:text-accent"
                >
                  <Icon name={s.name} class="size-5" />
                  <span class="sr-only">{s.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div>
      <h2 class="text-sm font-bold tracking-[0.14em] text-accent uppercase">{t.footer.hours}</h2>
      {locations.map((loc) => (
        <div class="mt-4">
          {locations.length > 1 && <p class="font-bold">{loc.name}</p>}
          <dl class="mt-1 space-y-1.5 text-muted">
            {hoursSummary(loc.hours, lang, t).map(([days, time]) => (
              <div class="flex justify-between gap-4">
                <dt class="whitespace-nowrap">{days}</dt>
                <dd class="text-right whitespace-nowrap text-ink">{time}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>

    <div>
      <h2 class="text-sm font-bold tracking-[0.14em] text-accent uppercase">{t.footer.contact}</h2>
      <ul class="mt-4 space-y-3">
        <li>
          <a
            href={`tel:${site.phone.e164}`}
            class="flex items-center gap-2 font-bold hover:text-accent"
          >
            <Icon name="phone" class="size-5 text-accent" />
            {site.phone.display}
          </a>
        </li>
        {!site.email.endsWith('.example') && (
          <li>
            <a href={`mailto:${site.email}`} class="break-all text-muted hover:text-ink">
              {site.email}
            </a>
          </li>
        )}
        {locations.map((loc) => (
          <li>
            <a
              href={pathFor(lang, { location: loc.id })}
              class="flex gap-2 text-muted hover:text-ink"
            >
              <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-accent" />
              <span>
                {loc.address.street}
                <br />
                {loc.address.city}, {loc.address.region} {loc.address.postalCode}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold tracking-[0.14em] text-accent uppercase">{t.footer.services}</h2>
      <ul class="mt-4 space-y-2.5">
        {services
          .filter((s) => s.featured)
          .map((s) => (
            <li>
              <a href={pathFor(lang, { service: s.id })} class="text-muted hover:text-ink">
                {t.services.items[s.id].name}
              </a>
            </li>
          ))}
        <li>
          <a href={pathFor(lang, 'services')} class="font-bold text-accent hover:text-ink">
            {t.cta.allServices}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-x flex flex-col items-start justify-between gap-2 py-6 text-sm text-muted sm:flex-row sm:items-center">
      <p>
        © {year} {site.name}. {t.footer.rights}
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a
          href="https://azulwebdev.com"
          target="_blank"
          rel="noopener"
          class="text-xs underline-offset-4 hover:text-accent hover:underline"
        >
          {lang === 'es' ? 'Diseño y desarrollo por Azul' : 'Design & development by Azul'}
          <span class="sr-only">
            {' '}
            ({lang === 'es' ? 'abre en otra pestaña' : 'opens in a new tab'})
          </span>
        </a>
        <LangToggle lang={lang} alternates={alternates} class="-ml-3 text-ink" />
      </div>
    </div>
  </div>
</footer>
