---
/**
 * Friday promo. Server HTML says "Every Friday"; a tiny script checks the day in
 * the shop's timezone (America/New_York) and flips to "Today only" on Fridays.
 * Both variants occupy the same grid cell, so the swap causes no layout shift.
 */
import { primaryLocation, promo, site } from '../config/site.ts';
import { pathFor, type Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="specials" class="section scroll-mt-4" aria-labelledby="specials-title">
  <div class="container-x">
    <div
      data-promo
      data-day={promo.dayOfWeek}
      data-tz={primaryLocation.timezone}
      data-today="false"
      class="group on-dark tile-bg-dark relative overflow-hidden rounded-[2rem] bg-ink text-cream"
    >
      <div class="grid gap-10 p-6 sm:p-10 lg:grid-cols-[auto_1fr] lg:items-center lg:gap-16 lg:p-14">
        <div class="flex flex-wrap items-end gap-x-4 gap-y-3 lg:flex-col lg:items-start">
          <p
            class="text-[6.5rem] leading-[0.8] font-black tracking-[-0.06em] text-accent-light tabular-nums sm:text-[9rem]"
            aria-hidden="true"
          >
            {promo.percentOff}<span class="text-[0.5em] tracking-normal">%</span>
          </p>
          <span
            class="mb-2 inline-grid rounded-full border-2 whitespace-nowrap border-brass px-4 py-1.5 text-sm font-extrabold tracking-[0.12em] uppercase group-data-[today=true]:border-accent-light group-data-[today=true]:bg-accent-light group-data-[today=true]:text-ink lg:mb-0"
          >
            <span class="col-start-1 row-start-1 text-center group-data-[today=true]:invisible">{t.promo.everyFriday}</span>
            <span class="invisible col-start-1 row-start-1 inline-flex items-center justify-center gap-2 group-data-[today=true]:visible">
              <span class="size-2 animate-pulse rounded-full bg-accent-dark" aria-hidden="true"></span>
              {t.promo.todayOnly}
            </span>
          </span>
        </div>

        <div>
          <p class="eyebrow">{t.promo.eyebrow}</p>
          <h2 id="specials-title" class="mt-3 grid text-h2">
            <span class="col-start-1 row-start-1 group-data-[today=true]:invisible">{t.promo.title(promo.percentOff)}</span>
            <span class="invisible col-start-1 row-start-1 group-data-[today=true]:visible">{t.promo.titleToday(promo.percentOff)}</span>
          </h2>
          <p class="mt-4 max-w-xl text-lg text-mist">{t.promo.lead}</p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-3">
            {
              promo.items.map((item) => (
                <li class="flex items-center gap-3 rounded-2xl bg-ink-2 px-4 py-3 font-bold">
                  <Icon name="check" class="size-5 shrink-0 text-accent-light" />
                  {t.promo.items[item]}
                </li>
              ))
            }
          </ul>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={pathFor(lang, 'book')} class="btn btn-primary">
              <Icon name="calendar" />
              {t.cta.book}
            </a>
            <a href={`tel:${site.phone.e164}`} class="btn btn-secondary">
              <Icon name="phone" />
              {t.cta.callNow}
            </a>
          </div>
          <p class="mt-5 text-sm text-mist">{t.promo.fine}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { isPromoDay } from '../lib/hours.ts';

  document.querySelectorAll<HTMLElement>('[data-promo]').forEach((el) => {
    el.dataset.today = String(isPromoDay(Number(el.dataset.day), el.dataset.tz!));
  });
</script>
