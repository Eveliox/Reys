---
import { primaryLocation, site } from '../config/site.ts';
import { pathFor, type Lang } from '../i18n/routes.ts';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';
---

<section class="cinematic-hero on-dark" aria-labelledby="hero-title">
  <div class="hero-film">
    <video
      id="hero-video"
      src="/videos/auto-care.mp4"
      poster="/videos/auto-care-poster.webp"
      preload="none"
      muted
      loop
      playsinline
      controls
      aria-label={
        es
          ? 'Mecánico trabajando debajo de un vehículo elevado'
          : 'Mechanic working beneath a vehicle on a lift'
      }
    ></video>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="container-x hero-content">
    <p class="hero-kicker">
      {es ? 'REY’S AUTO REPAIR / LITTLE HAVANA' : 'REY’S AUTO REPAIR / LITTLE HAVANA'}
    </p>
    <h1 id="hero-title">
      <span>{es ? 'TU CARRO.' : 'YOUR CAR.'}</span>
      <span>{es ? 'EN BUENAS' : 'IN GOOD'}</span>
      <span>{es ? 'MANOS.' : 'HANDS.'}</span>
    </h1>
    <p class="hero-description">
      {es
        ? 'Diagnóstico preciso. Mantenimiento de todos los días. Tu taller aquí en Miami.'
        : 'Specialist diagnostics. Everyday maintenance. Your neighborhood workshop in Miami.'}
    </p>
    <div class="hero-actions">
      <a href={pathFor(lang, 'book')} class="btn btn-primary">
        {es ? 'Programa tu visita' : 'Schedule your visit'}
        <Icon name="arrow" />
      </a>
      <a href="#services" class="hero-explore">
        {es ? 'Explora los servicios' : 'Explore our services'}
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
  <button
    type="button"
    class="video-toggle"
    data-video-toggle
    data-play={es ? 'Reproducir video' : 'Play video'}
    data-pause={es ? 'Pausar video' : 'Pause video'}
    aria-controls="hero-video"
    hidden
  >
    {es ? 'Reproducir video' : 'Play video'}
  </button>
  <div class="hero-bottom container-x">
    <p class="hero-location">
      <Icon name="pin" />
      527 SW 15th Ave · Miami, FL
    </p>
    <div class="hero-contact">
      <p>{es ? 'Habla con el taller' : 'Talk to the shop'}</p>
      <a href={`tel:${site.phone.e164}`} class="hero-phone">
        {site.phone.display}
        <Icon name="arrow" />
      </a>
      <OpenStatus location={primaryLocation} lang={lang} />
    </div>
  </div>
</section>
<style>
  .cinematic-hero {
    position: relative;
    isolation: isolate;
    min-height: 760px;
    min-height: min(840px, calc(100svh - 80px));
    background: var(--color-ink);
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .hero-film,
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-film video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }
  .hero-shade {
    pointer-events: none;
    z-index: -1;
    background:
      linear-gradient(90deg, #080c10db 0%, #080c1077 60%, #080c101a),
      linear-gradient(0deg, #080c10aa, transparent 55%);
  }
  .hero-content {
    padding-top: 70px;
    padding-bottom: 175px;
  }
  .hero-kicker {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    font-weight: 750;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hero-kicker:before {
    content: '';
    width: 26px;
    height: 3px;
    background: var(--color-accent);
  }
  h1 {
    font-size: clamp(3.6rem, 7.8vw, 7.5rem);
    line-height: 0.91;
    letter-spacing: -0.055em;
    margin: 24px 0;
    font-weight: 900;
  }
  h1 span {
    display: block;
  }
  .hero-description {
    max-width: 390px;
    line-height: 1.6;
    color: #eee;
    font-size: 1rem;
  }
  .hero-actions {
    display: flex;
    gap: 28px;
    align-items: center;
    margin-top: 28px;
  }
  .hero-explore {
    font-size: 0.8rem;
    font-weight: 650;
    border-bottom: 1px solid #ffffff70;
    padding: 12px 0;
  }
  .hero-explore span {
    margin-left: 16px;
  }
  .hero-explore:hover {
    border-color: white;
  }
  .hero-bottom {
    pointer-events: none;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: end;
  }
  .hero-location {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    padding-bottom: 30px;
  }
  .hero-contact {
    pointer-events: auto;
    background: white;
    color: var(--color-ink);
    padding: 22px 28px;
    min-width: 350px;
    border-top: 4px solid var(--color-accent);
  }
  .hero-contact > p {
    font-size: 0.6rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .hero-phone {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 7px 0;
  }
  .hero-contact :focus-visible {
    outline-color: var(--color-accent);
  }
  .hero-phone:hover {
    color: var(--color-accent);
  }
  .video-toggle {
    position: absolute;
    top: 20px;
    right: max(16px, calc((100vw - 1216px) / 2));
    min-height: 44px;
    padding: 10px 16px;
    background: #080c10a8;
    border: 1px solid #ffffff80;
    color: white;
    font-size: 0.7rem;
    font-weight: 650;
    cursor: pointer;
  }
  .video-toggle:hover {
    background: var(--color-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-kicker,
    .hero-description,
    .hero-actions {
      animation: hero-enter 0.8s both;
    }
    .hero-description {
      animation-delay: 0.25s;
    }
    .hero-actions {
      animation-delay: 0.35s;
    }
    h1 span {
      animation: hero-enter 0.85s cubic-bezier(0.2, 0.65, 0.25, 1) both;
    }
    h1 span:nth-child(2) {
      animation-delay: 0.1s;
    }
    h1 span:nth-child(3) {
      animation-delay: 0.2s;
    }
    @keyframes hero-enter {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
  @media (max-width: 767px) {
    .cinematic-hero {
      min-height: 760px;
      min-height: max(730px, calc(100svh - 64px));
    }
    .hero-content {
      padding-top: 90px;
      padding-bottom: 190px;
    }
    h1 {
      font-size: clamp(3.6rem, 15vw, 6rem);
    }
    .hero-description {
      max-width: 310px;
      font-size: 0.9rem;
    }
    .hero-actions {
      gap: 18px;
      flex-wrap: wrap;
    }
    .hero-actions .btn {
      padding-inline: 18px;
      font-size: 0.9rem;
    }
    .hero-explore {
      font-size: 0.72rem;
    }
    .hero-bottom {
      padding: 0;
    }
    .hero-location {
      display: none;
    }
    .hero-contact {
      min-width: 0;
      width: 100%;
      padding: 18px 20px;
    }
    .hero-phone {
      font-size: 1.65rem;
    }
    .hero-film video {
      object-position: 55% center;
    }
    .hero-shade {
      background: linear-gradient(90deg, #080c10cd, #080c1070);
    }
    .hero-kicker {
      font-size: 0.58rem;
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('#hero-video');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  if (video && toggle) {
    // Autoplays for everyone; the pause button lets visitors stop it (WCAG 2.2.2).
    // Browsers in battery-saver mode may still block autoplay; the button then reads "Play".
    // Playback starts after the page's load event so the 1.6 MB video doesn't compete
    // with the poster image (the LCP element) on slow mobile connections.
    let wantsPlayback = true;
    let inView = false;
    let pageLoaded = document.readyState === 'complete';
    video.muted = true;
    video.controls = false;
    toggle.hidden = false;
    const updateLabel = () => {
      toggle.textContent = video.paused ? toggle.dataset.play! : toggle.dataset.pause!;
    };
    const syncPlayback = () => {
      if (wantsPlayback && inView && pageLoaded && !document.hidden) {
        void video.play().catch(updateLabel);
      } else video.pause();
    };
    video.addEventListener('play', updateLabel);
    video.addEventListener('pause', updateLabel);
    video.addEventListener('error', () => {
      toggle.hidden = true;
    });
    toggle.addEventListener('click', () => {
      wantsPlayback = video.paused;
      syncPlayback();
    });
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        syncPlayback();
      },
      { threshold: 0.15 },
    ).observe(video);
    document.addEventListener('visibilitychange', syncPlayback);
    window.addEventListener('load', () => {
      pageLoaded = true;
      syncPlayback();
    });
  }
</script>
