---
import { primaryLocation, promo, site } from '../config/site.ts';
import { pathFor, type Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import Icon from './Icon.astro';
import ImageSlot from './ImageSlot.astro';
import OpenStatus from './OpenStatus.astro';
import RatingBadge from './RatingBadge.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div
    class="tile-bg pointer-events-none absolute inset-y-0 right-0 hidden w-1/2 lg:block"
    aria-hidden="true"
  ></div>
  <div class="container-x relative grid items-center gap-10 pt-8 pb-14 sm:pt-14 lg:grid-cols-[1.15fr_1fr] lg:gap-14 lg:py-20">
    <div>
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="mt-4 text-display">
        {t.hero.title}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted sm:text-xl">{t.hero.subtitle}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={`tel:${site.phone.e164}`} class="btn btn-primary min-h-14 px-8 text-lg">
          <Icon name="phone" class="size-5" />
          {t.cta.callNow}
          <span class="font-semibold opacity-90 max-sm:hidden">{site.phone.display}</span>
        </a>
        <a href={pathFor(lang, 'book')} class="btn btn-secondary min-h-14 px-8 text-lg">
          <Icon name="calendar" class="size-5" />
          {t.cta.book}
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <RatingBadge lang={lang} />
        <OpenStatus location={primaryLocation} lang={lang} />
      </div>
    </div>

    <div class="relative">
      <ImageSlot
        id="hero"
        alt={t.hero.imageAlt}
        ratio="4 / 3.6"
        icon="wrench"
        priority
        sizes="(min-width: 1024px) 45vw, 100vw"
      />
      <a
        href="#specials"
        class="absolute -bottom-5 left-5 hidden rounded-2xl bg-accent px-5 py-4 text-white shadow-lg hover:bg-accent-dark sm:block"
      >
        <span class="block text-xs font-bold tracking-[0.14em] uppercase">{t.promo.eyebrow}</span>
        <span class="block text-xl font-black">{t.promo.off(promo.percentOff)}</span>
      </a>
    </div>
  </div>
</section>
