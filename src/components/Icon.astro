---
/**
 * Inline stroke icons (24×24). Decorative by default (aria-hidden);
 * pass `label` to make an icon meaningful to screen readers.
 * No manufacturer logos — service icons are generic illustrations.
 */
const icons = {
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h2M14 15h2"/>',
  star: '<path fill="currentColor" stroke="none" d="m12 2.6 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.5l-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  message:
    '<path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-5 4V6a1 1 0 0 1 1-1z"/><path d="M8 10h8M8 13h5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7"/>',
  directions:
    '<path d="M12 2.5 21.5 12 12 21.5 2.5 12z"/><path d="M9.5 14v-3h5M12.5 8.5l2.5 2.5-2.5 2.5"/>',
  external:
    '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  shield:
    '<path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  wrench:
    '<path d="M14.5 6.5a4 4 0 0 0 5 5l-9 9a2.1 2.1 0 0 1-3-3l9-9a4 4 0 0 1 5-5l-2.5 2.5.5 2 2 .5z"/>',
  gauge:
    '<path d="M4.5 18a9 9 0 1 1 15 0"/><path d="m12 13 4-4"/><circle cx="12" cy="13" r="1.4"/><path d="M7 12h1M12 7v1M17 12h-1"/>',
  german:
    '<path d="M4 10h3l1.5-2h6L16 10h2v2h2v4h-2v2h-3l-1.5 1.5h-5L7 18H4z"/><path d="M8 8V5.5h6V8M10 5.5V4M12 5.5V4"/><path d="M4 13H2.5M10 12h3"/>',
  oil: '<path d="M12 3s-5.5 6.2-5.5 10a5.5 5.5 0 0 0 11 0C17.5 9.2 12 3 12 3z"/><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5"/>',
  gears:
    '<circle cx="12" cy="12" r="3"/><path d="M12 2.5v3M12 18.5v3M21.5 12h-3M5.5 12h-3M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1M18.7 18.7l-2.1-2.1M7.4 7.4 5.3 5.3"/><circle cx="12" cy="12" r="6.5"/>',
  classic:
    '<path d="M2.5 15.5v-2.5l2.5-1 2.5-4h7l3.5 4 3 .8v2.7h-2"/><path d="M6.5 15.5h9"/><circle cx="5" cy="16" r="2"/><circle cx="18" cy="16" r="2"/><path d="M8.5 12h8M11.5 8v4"/>',
  award: '<circle cx="12" cy="9" r="6"/><path d="m8.5 14-1.5 7 5-2.5 5 2.5-1.5-7"/>',
  facebook: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5A.5.5 0 0 1 14 8z"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/>',
  google:
    '<path d="M20 12.2c0-.6-.1-1.2-.2-1.7H12v3.3h4.5a4.6 4.6 0 0 1-4.5 3.4 5.2 5.2 0 1 1 3.4-9.1l2.4-2.3A8.6 8.6 0 1 0 20 12.2z"/>',
  yelp: '<path d="M12 3v8M12 11l-6.5-3M12 11l6.5-3M12 11l-4.5 7M12 11l4.5 7"/>',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  size?: number;
}

const { name, class: className = 'size-5', label, size } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  width={size}
  height={size}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
