---
/**
 * Image placeholder with a fixed aspect ratio (no layout shift).
 * To add a real photo: put it in src/assets/ and pass it as `src`, e.g.
 *   import hero from '../assets/hero.jpg';  <ImageSlot id="hero" src={hero} … />
 * Astro will generate responsive, compressed versions automatically.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  /** Stable id so images are easy to find and swap: data-image-slot="hero". */
  id: string;
  alt: string;
  src?: ImageMetadata;
  /** CSS aspect-ratio, e.g. "4 / 5". */
  ratio?: string;
  icon?: IconName;
  priority?: boolean;
  sizes?: string;
  class?: string;
}
const {
  id,
  alt,
  src,
  ratio = '4 / 3',
  icon = 'wrench',
  priority = false,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  class: className,
} = Astro.props;
---

<div
  data-image-slot={id}
  class:list={['relative overflow-hidden rounded-3xl bg-ink', className]}
  style={`aspect-ratio: ${ratio}`}
>
  {src ? (
    <Image
      src={src}
      alt={alt}
      widths={[480, 768, 1080, 1440]}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="absolute inset-0 size-full object-cover"
    />
  ) : (
    <div class="tile-bg-dark absolute inset-0 flex items-center justify-center" aria-hidden="true">
      <div class="absolute inset-0 bg-gradient-to-br from-ink-2/0 via-ink/40 to-ink" />
      <Icon name={icon} class="relative size-1/4 max-w-32 text-brass/70" />
    </div>
  )}
</div>
