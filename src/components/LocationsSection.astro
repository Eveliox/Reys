---
import { locations } from '../config/site.ts';
import type { Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import LocationCard from './LocationCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="locations" class="section scroll-mt-4" aria-labelledby="locations-title">
  <div class="container-x">
    <p class="eyebrow">{t.locations.eyebrow}</p>
    <h2 id="locations-title" class="mt-3 text-h2">
      {locations.length > 1 ? t.locations.titleMany : t.locations.title}
    </h2>
    <p class="mt-4 max-w-xl text-lg text-muted">{t.locations.intro}</p>
    <div class="mt-10 space-y-8">
      {locations.map((l) => <LocationCard location={l} lang={lang} />)}
    </div>
  </div>
</section>
