---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<span class:list={['wordmark', dark && 'wordmark-light']}>
  <span class="wordmark-name">
    REY’S<span aria-hidden="true">/</span>
  </span>
  <span class="wordmark-description">AUTO REPAIR</span>
</span>
<style>
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    color: var(--color-ink);
  }
  .wordmark-name {
    font-size: 2.1rem;
    line-height: 0.9;
    font-weight: 950;
    letter-spacing: -0.075em;
    font-style: italic;
  }
  .wordmark-name > span {
    color: var(--color-accent);
    margin-left: 4px;
    font-style: normal;
  }
  .wordmark-description {
    margin-top: 5px;
    font-size: 0.56rem;
    font-weight: 750;
    letter-spacing: 0.29em;
  }
  .wordmark-light {
    color: white;
  }
</style>
