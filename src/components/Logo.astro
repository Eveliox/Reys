---
/** Text wordmark. [PLACEHOLDER] swap for the real logo when available. */
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <svg viewBox="0 0 40 40" class="size-9 shrink-0" aria-hidden="true">
    <rect width="40" height="40" rx="10" fill="#b8411c"></rect>
    <path
      d="M20 7 33 20 20 33 7 20z"
      fill="none"
      stroke="#faf5ec"
      stroke-width="2"
      stroke-linejoin="round"></path>
    <circle cx="20" cy="20" r="4.5" fill="#faf5ec"></circle>
  </svg>
  <span class="flex flex-col leading-none">
    <span
      class:list={['text-[1.35rem] font-black tracking-tight', dark ? 'text-cream' : 'text-ink']}
      >Rey’s</span
    >
    <span
      class:list={[
        'text-[0.68rem] font-bold tracking-[0.2em] uppercase',
        dark ? 'text-mist' : 'text-muted',
      ]}>Auto Repair</span
    >
  </span>
</span>
