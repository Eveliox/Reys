---
import { primaryLocation, site } from '../config/site.ts';
import { type Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import { directionsUrl } from '../lib/format.ts';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/95 px-3 pt-3 backdrop-blur md:hidden"
  style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom))"
>
  <div class="grid grid-cols-2 gap-2">
    <a
      href={`tel:${site.phone.e164}`}
      class="btn btn-primary min-h-13 px-3 text-sm"
      aria-label={`${t.cta.callNow}: ${site.phone.display}`}
    >
      <Icon name="phone" class="size-5" />
      {t.cta.callNow}
    </a>
    <a
      href={directionsUrl(primaryLocation.address)}
      target="_blank"
      rel="noopener"
      class="btn btn-secondary min-h-13 px-3 text-sm"
    >
      <Icon name="directions" class="size-5" />
      {t.cta.directions}
    </a>
  </div>
</div>
