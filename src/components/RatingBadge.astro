---
import { site } from '../config/site.ts';
import type { Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  dark?: boolean;
}
const { lang, dark = false } = Astro.props;
const t = useTranslations(lang);
---

<a
  href={site.googleReviewsUrl}
  target="_blank"
  rel="noopener"
  class:list={[
    'group inline-flex items-center gap-3 rounded-2xl border py-2 pr-4 pl-3 transition-colors',
    dark
      ? 'border-ink-3 bg-ink-2 text-cream hover:border-brass'
      : 'border-line bg-paper text-ink shadow-sm hover:border-ink',
  ]}
>
  <span class="text-[2rem] leading-none font-black tracking-tight tabular-nums">
    {site.rating.value}
  </span>
  <span class="flex flex-col gap-1">
    <span class="flex text-[#b7791f]" role="img" aria-label={t.rating.outOf(site.rating.value)}>
      {Array.from({ length: 5 }, () => (
        <Icon name="star" class="size-4" />
      ))}
    </span>
    <span class:list={['text-sm font-semibold', dark ? 'text-mist' : 'text-muted']}>
      {t.rating.reviews(site.rating.countLabel)}
      <Icon name="external" class="ml-0.5 inline size-3.5 align-[-2px]" />
    </span>
  </span>
</a>
