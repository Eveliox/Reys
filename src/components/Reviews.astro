---
import { site } from '../config/site.ts';
import type { Lang } from '../i18n/routes.ts';
import Icon from './Icon.astro';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';
---

<section class="bg-paper py-12" aria-labelledby="reviews-title">
  <div class="container-x flex flex-col justify-between gap-6 md:flex-row md:items-center">
    <div class="flex items-center gap-5">
      <span class="flex size-14 shrink-0 items-center justify-center rounded-full border border-line text-accent">
        <Icon name="message" class="size-6" />
      </span>
      <div>
        <p class="eyebrow">{es ? 'La opinión de nuestros clientes' : 'From our customers'}</p>
        <h2 id="reviews-title" class="mt-2 text-2xl tracking-tight">
          {es ? 'Conoce su experiencia con Rey’s.' : 'Hear about their experience at Rey’s.'}
        </h2>
      </div>
    </div>
    <a
      href={site.googleReviewsUrl}
      target="_blank"
      rel="noopener"
      class="btn btn-secondary shrink-0"
    >
      {es ? 'Ver reseñas en Google' : 'Read Google reviews'}
      <Icon name="external" />
    </a>
  </div>
</section>
