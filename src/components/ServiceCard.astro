---
import { Image } from 'astro:assets';
import german from '../assets/shop/rey4.jpg';
import diagnostics from '../assets/shop/rey6.jpg';
import oil from '../assets/shop/rey7.jpg';
import { type Service } from '../config/site.ts';
import { pathFor, type Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import Icon from './Icon.astro';
interface Props {
  service: Service;
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
}
const { service, lang, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const copy = t.services.items[service.id];
const Heading = headingLevel;
const photos: Partial<Record<Service['id'], import('astro').ImageMetadata>> = {
  german,
  diagnostics,
  'oil-change': oil,
};
const photo = photos[service.id];
---

<article
  class:list={[
    'service-card group relative flex h-full flex-col overflow-hidden rounded-xl border border-line transition-shadow hover:shadow-xl',
    'bg-paper text-ink',
  ]}
>
  {photo && (
    <div class:list={['overflow-hidden', service.premium ? 'h-64' : 'h-48']}>
      <Image
        src={photo}
        alt=""
        loading="lazy"
        class="size-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105"
      />
    </div>
  )}
  {!photo && (
    <div
      class:list={[
        'relative flex items-center justify-between overflow-hidden px-7',
        service.premium ? 'h-64 bg-sand' : 'h-48 bg-sand',
      ]}
    >
      <Icon name={service.icon} class="relative z-10 size-20 text-accent" />
      <span class="service-line" aria-hidden="true"></span>
      <span class="relative z-10 text-xs font-bold tracking-[.2em] uppercase">
        {lang === 'es' ? 'Cuidado especializado' : 'Specialized care'}
      </span>
    </div>
  )}
  <div class="flex flex-1 flex-col p-7 sm:p-8">
    <p class:list={['text-xs font-bold tracking-[.16em] uppercase', 'text-accent']}>
      {service.premium ? t.services.specialty : t.services.eyebrow}
    </p>
    <Heading class="mt-3 text-2xl leading-tight tracking-tight">
      <a href={pathFor(lang, { service: service.id })} class="after:absolute after:inset-0">
        {copy.name}
      </a>
    </Heading>
    <p class:list={['mt-3 leading-relaxed', 'text-muted']}>{copy.short}</p>
    <div
      class:list={['mt-auto flex items-center justify-between border-t pt-5', 'border-line']}
      style="margin-top: 1.75rem"
    >
      <span class="text-sm font-bold">{t.cta.readMore}</span>
      <Icon name="arrow" class={'text-accent'} />
    </div>
  </div>
</article>
<style>
  .service-card:focus-within {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }
  .service-line {
    position: absolute;
    width: 280px;
    height: 280px;
    border: 1px solid #84929e30;
    border-radius: 50%;
    right: -65px;
    box-shadow:
      0 0 0 30px #84929e12,
      0 0 0 60px #84929e0a;
  }
</style>
