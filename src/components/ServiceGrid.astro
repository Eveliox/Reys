---
import { Image } from 'astro:assets';
import porsche from '../assets/editorial/porsche-red.jpg';
import electrical from '../assets/editorial/engine-service.jpg';
import diagnostics from '../assets/shop/rey6.jpg';
import team from '../assets/shop/rey7.jpg';
import classic from '../assets/shop/rey10.jpg';
import repair from '../assets/shop/rey4.jpg';
import { services } from '../config/site.ts';
import { pathFor, type Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import Icon from './Icon.astro';
interface Props {
  lang: Lang;
  showHeader?: boolean;
  showAllLink?: boolean;
}
const { lang, showHeader = true, showAllLink = false } = Astro.props;
const t = useTranslations(lang);
const es = lang === 'es';
const list = showHeader ? services.filter((s) => s.featured) : services;
const photos = [
  {
    src: porsche,
    alt: es ? 'Detalle de un Porsche rojo' : 'Detail of a red Porsche',
    credit: 'Zieben VH / Unsplash',
  },
  {
    src: diagnostics,
    alt: es ? 'Técnico con equipo de diagnóstico' : 'Technician using diagnostic equipment',
    credit: es ? 'En el taller' : 'At the workshop',
  },
  {
    src: team,
    alt: es ? 'Equipo trabajando en un cambio de aceite' : 'Team working on an oil change',
    credit: es ? 'En el taller' : 'At the workshop',
  },
  {
    src: repair,
    alt: es ? 'Técnico trabajando debajo de un BMW' : 'Technician working beneath a BMW',
    credit: es ? 'En el taller' : 'At the workshop',
  },
  {
    src: electrical,
    alt: es
      ? 'Detalle del sistema eléctrico de un vehículo'
      : 'Detail of a vehicle electrical system',
    credit: 'Maxim Hopman / Unsplash',
  },
  {
    src: classic,
    alt: es
      ? 'Técnico trabajando en un Mini clásico verde'
      : 'Technician working on a green classic Mini',
    credit: es ? 'En el taller' : 'At the workshop',
  },
];
const photoIndex = (id: string) =>
  id === 'classic'
    ? 5
    : id === 'german'
      ? 0
      : id === 'diagnostics'
        ? 1
        : ['oil-change', 'maintenance'].includes(id)
          ? 2
          : ['electrical', 'engine', 'ac-heating'].includes(id)
            ? 4
            : 3;
const Heading = showHeader ? 'h3' : 'h2';
---

<section
  id="services"
  data-service-explorer
  class:list={['services-editorial scroll-mt-28', showHeader ? 'section' : 'pb-16 sm:pb-24']}
  aria-labelledby={showHeader ? 'services-title' : undefined}
  aria-label={showHeader ? undefined : t.nav.services}
>
  <div class="container-x">
    {showHeader && (
      <div class="service-heading">
        <div>
          <p class="eyebrow">{es ? '01 / Nuestros servicios' : '01 / Our services'}</p>
          <h2 id="services-title" class="mt-4 text-h2">
            {es ? 'Todo empieza bajo el capó.' : 'It starts under the hood.'}
          </h2>
        </div>
        <p>
          {es
            ? 'Selecciona un servicio para ver cómo podemos ayudarte.'
            : 'Choose a service to see how we can help.'}
        </p>
      </div>
    )}
    <div class="service-layout">
      <div class="service-visual" aria-live="off">
        {photos.map((photo, index) => (
          <figure data-service-photo={index} hidden={index !== photoIndex(list[0].id)}>
            <Image
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              widths={index === 0 || index === 4 ? [480, 800, 1200] : undefined}
              sizes="(min-width: 1024px) 40vw, 100vw"
            />
            <figcaption>
              <span data-photo-title>{t.services.items[list[0].id].name}</span>
              <small>{photo.credit}</small>
            </figcaption>
          </figure>
        ))}
        <p class="visual-footnote">
          {es ? 'Tu carro, el servicio adecuado.' : 'Your vehicle. The right service.'}
          <span aria-hidden="true">↗</span>
        </p>
      </div>
      <div class="service-list">
        {list.map((service, i) => (
          <details
            class="service-choice"
            data-service-choice
            data-photo={photoIndex(service.id)}
            data-title={t.services.items[service.id].name}
            open={i === 0}
          >
            <summary>
              <span class="service-number">{String(i + 1).padStart(2, '0')}</span>
              <Heading>{t.services.items[service.id].name}</Heading>
              <span class="choice-mark" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="service-detail">
              <p>{t.services.items[service.id].short}</p>
              <ul>
                {t.services.items[service.id].includes.slice(0, 3).map((item) => (
                  <li>
                    <Icon name="check" class="size-4" />
                    {item}
                  </li>
                ))}
              </ul>
              <div class="service-links">
                <a href={pathFor(lang, { service: service.id })}>
                  {es ? 'Ver el servicio' : 'Explore this service'}
                  <Icon name="arrow" />
                </a>
                <a href={`${pathFor(lang, 'book')}?service=${service.id}`} class="service-book">
                  {es ? 'Planificar visita' : 'Plan a visit'}
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
    {showAllLink && (
      <a href={pathFor(lang, 'services')} class="service-all">
        {t.cta.allServices}
        <Icon name="arrow" />
      </a>
    )}
  </div>
</section>
<style>
  .service-heading {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 4rem;
    align-items: end;
    margin-bottom: 3rem;
  }
  .service-heading > p {
    max-width: 330px;
    justify-self: end;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .service-layout {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 4.5rem;
    align-items: start;
  }
  .service-visual {
    position: sticky;
    top: 110px;
  }
  .service-visual figure {
    height: 540px;
    position: relative;
    background: var(--color-ink);
    overflow: hidden;
  }
  .service-visual figure[hidden] {
    display: none;
  }
  .service-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .service-visual figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 4rem 1.5rem 1.5rem;
    color: white;
    background: linear-gradient(transparent, #000d);
  }
  figcaption span {
    display: block;
    max-width: 350px;
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  figcaption small {
    display: block;
    margin-top: 0.8rem;
    font-size: 0.6rem;
  }
  .visual-footnote {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--color-muted);
    padding-top: 12px;
  }
  .service-choice {
    border-top: 1px solid var(--color-line);
  }
  .service-choice:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  summary {
    display: grid;
    grid-template-columns: 1.5rem 1fr 20px;
    align-items: center;
    gap: 1rem;
    min-height: 80px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h2,
  summary h3 {
    font-size: 1.2rem;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }
  .service-number {
    font-size: 0.65rem;
    color: var(--color-muted);
    font-weight: 650;
  }
  .choice-mark {
    font-size: 1.5rem;
    font-weight: 400;
    transition: transform 0.2s;
  }
  .service-choice[open] summary {
    color: var(--color-accent);
  }
  .service-choice[open] .choice-mark {
    transform: rotate(45deg);
  }
  .service-detail {
    padding: 0 0 26px 2.5rem;
  }
  .service-detail > p {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .service-detail ul {
    margin: 20px 0;
    font-size: 0.8rem;
    display: grid;
    gap: 10px;
  }
  .service-detail li {
    display: flex;
    gap: 10px;
    align-items: start;
  }
  .service-detail li svg {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .service-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 0.75rem;
    font-weight: 750;
  }
  .service-links a {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .service-links a:hover {
    color: var(--color-accent);
  }
  .service-book {
    color: var(--color-accent);
  }
  .service-all {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-top: 2rem;
    width: fit-content;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.5rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .service-choice[open] .service-detail {
      animation: detail-in 0.3s ease;
    }
    .service-visual figure:not([hidden]) img {
      animation: photo-in 0.5s ease;
    }
    @keyframes detail-in {
      from {
        opacity: 0;
        transform: translateY(-5px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes photo-in {
      from {
        opacity: 0.3;
        transform: scale(1.025);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
  @media (max-width: 767px) {
    .service-heading,
    .service-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .service-heading > p {
      justify-self: start;
    }
    .service-visual {
      position: static;
    }
    .service-visual figure {
      height: 300px;
    }
    .service-heading {
      margin-bottom: 2rem;
    }
    summary {
      min-height: 76px;
      gap: 0.6rem;
    }
    summary h2,
    summary h3 {
      font-size: 1.1rem;
    }
    .service-detail {
      padding-left: 2.1rem;
    }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-service-explorer]').forEach((explorer) => {
    const choices = [...explorer.querySelectorAll<HTMLDetailsElement>('[data-service-choice]')];
    choices.forEach((choice) =>
      choice.addEventListener('toggle', () => {
        if (!choice.open) return;
        choices.forEach((other) => {
          if (other !== choice) other.open = false;
        });
        explorer.querySelectorAll<HTMLElement>('[data-service-photo]').forEach((photo) => {
          const active = photo.dataset.servicePhoto === choice.dataset.photo;
          photo.hidden = !active;
          if (active)
            photo.querySelector('[data-photo-title]')!.textContent = choice.dataset.title!;
        });
      }),
    );
  });
</script>
