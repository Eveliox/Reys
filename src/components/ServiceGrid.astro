---
import { Image } from 'astro:assets';
import porsche from '../assets/editorial/porsche-red.jpg';
import { services } from '../config/site.ts';
import { pathFor, type Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import Icon from './Icon.astro';
interface Props {
  lang: Lang;
  showHeader?: boolean;
  showAllLink?: boolean;
}
const { lang, showHeader = true, showAllLink = false } = Astro.props;
const t = useTranslations(lang);
const es = lang === 'es';
const Heading = showHeader ? 'h3' : 'h2';
// The home page shows featured services; /services shows every service.
const list = showHeader ? services.filter((s) => s.featured) : services;
---

<section
  id="services"
  class:list={['services-editorial scroll-mt-28', showHeader ? 'section' : 'pb-16 sm:pb-24']}
  aria-labelledby={showHeader ? 'services-title' : undefined}
  aria-label={showHeader ? undefined : t.nav.services}
>
  <div class="container-x">
    {showHeader && (
      <div class="service-heading">
        <div>
          <p class="eyebrow">{es ? '01 / Nuestros servicios' : '01 / Our services'}</p>
          <h2 id="services-title" class="mt-4 text-h2">
            {es ? 'Todo empieza bajo el capó.' : 'It starts under the hood.'}
          </h2>
        </div>
        <p>
          {es
            ? 'Del mantenimiento de rutina a una reparación especializada. Encuentra el servicio que necesita tu carro.'
            : 'From routine maintenance to specialist repairs. Find the right service for your vehicle.'}
        </p>
      </div>
    )}
    <div class="service-layout">
      <figure class="service-feature">
        <Image
          src={porsche}
          alt={
            es
              ? 'Detalle del capó y faro de un Porsche rojo'
              : 'Hood and headlight detail of a red Porsche'
          }
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          loading="lazy"
        />
        <figcaption>
          <span>
            {es
              ? 'Ingeniería alemana. Atención especializada.'
              : 'German engineering. Specialist attention.'}
          </span>
          <small>Zieben VH / Unsplash</small>
        </figcaption>
      </figure>
      <div class="service-list">
        {list.map((service, i) => (
          <article class="service-row">
            <span class="service-number">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <Heading>
                <a href={pathFor(lang, { service: service.id })}>
                  {t.services.items[service.id].name}
                  <Icon name="arrow" />
                </a>
              </Heading>
              <p>{t.services.items[service.id].short}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
    {showAllLink && (
      <a href={pathFor(lang, 'services')} class="service-all">
        {t.cta.allServices}
        <Icon name="arrow" />
      </a>
    )}
  </div>
</section>
<style>
  .service-heading {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 4rem;
    align-items: end;
    margin-bottom: 3rem;
  }
  .service-heading > p {
    max-width: 360px;
    justify-self: end;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .service-layout {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 4.5rem;
  }
  .service-feature {
    position: relative;
    min-height: 560px;
  }
  .service-feature img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 3rem 1.5rem 1.5rem;
    color: white;
    background: linear-gradient(transparent, #000b);
  }
  figcaption span {
    display: block;
    max-width: 300px;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  figcaption small {
    display: block;
    margin-top: 0.8rem;
    font-size: 0.6rem;
  }
  .service-row {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    border-top: 1px solid var(--color-line);
    padding: 1.5rem 0;
  }
  .service-number {
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 700;
    padding-top: 0.4rem;
  }
  h2 a,
  h3 a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    font-size: 1.3rem;
    letter-spacing: -0.04em;
  }
  h2 a:hover,
  h3 a:hover {
    color: var(--color-accent);
  }
  .service-row p {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin-top: 0.6rem;
    max-width: 440px;
  }
  .service-all {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-top: 2rem;
    width: fit-content;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.5rem;
  }
  @media (max-width: 767px) {
    .service-heading,
    .service-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .service-heading > p {
      justify-self: start;
    }
    .service-feature {
      min-height: 360px;
    }
    .service-heading {
      margin-bottom: 2rem;
    }
  }
</style>
