---
import { Image } from 'astro:assets';
import shop from '../assets/shop/rey3.jpg';
import team from '../assets/shop/rey7.jpg';
import repair from '../assets/shop/rey4.jpg';
import diagnostics from '../assets/shop/rey6.jpg';
import workshop from '../assets/shop/rey5.jpg';
import classic from '../assets/shop/rey10.jpg';
import sunroof from '../assets/shop/rey12.jpg';
import hatch from '../assets/shop/rey8.jpg';
import { pathFor, type Lang } from '../i18n/routes.ts';
import Icon from './Icon.astro';
interface Props {
  lang: Lang;
  gallery?: boolean;
}
const { lang, gallery = false } = Astro.props;
const es = lang === 'es';
const photos = [
  {
    src: classic,
    title: es ? 'Cuidado para los clásicos' : 'Care for the classics',
    alt: es
      ? 'Técnico trabajando bajo el capó de un Mini clásico verde en el taller'
      : 'Technician working under the hood of a green classic Mini at the shop',
  },
  {
    src: sunroof,
    title: es ? 'Trabajo de precisión' : 'A closer look at every detail',
    alt: es
      ? 'Técnico trabajando en el mecanismo del techo corredizo de un vehículo negro'
      : 'Technician working on the sunroof mechanism of a black vehicle',
  },
  {
    src: repair,
    title: es ? 'Manos a la obra' : 'Hands-on care',
    alt: es
      ? 'Mecánico trabajando debajo de un BMW elevado'
      : 'Mechanic working beneath a BMW on a lift',
  },
  {
    src: diagnostics,
    title: es ? 'Diagnóstico a fondo' : 'A closer look',
    alt: es
      ? 'Técnico usando un escáner de diagnóstico dentro de un vehículo'
      : 'Technician using a diagnostic scanner inside a vehicle',
  },
  {
    src: workshop,
    title: es ? 'Dentro del taller' : 'Inside the workshop',
    alt: es
      ? 'Vehículos en las áreas de servicio del taller'
      : 'Vehicles in the workshop service bays',
  },
  {
    src: hatch,
    title: es ? 'Atención a los detalles' : 'The details matter',
    alt: es
      ? 'Dos técnicos reparando la puerta trasera de un SUV'
      : 'Two technicians repairing an SUV rear hatch',
  },
];
---

{gallery ? (
  <section class="section bg-paper" aria-labelledby="shop-gallery-title">
    <div class="container-x">
      <p class="eyebrow">{es ? 'En el taller' : 'At the shop'}</p>
      <h2 id="shop-gallery-title" class="mt-3 text-h2">
        {es ? 'Conoce nuestro día a día.' : 'A look at what we do.'}
      </h2>
      <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-3">
        {photos.map((photo) => (
          <figure class="gallery-item overflow-hidden">
            <Image
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              class="aspect-[4/5] w-full object-cover"
            />
            <figcaption class="mt-3 text-sm font-bold">{photo.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
) : (
  <section class="section bg-paper" aria-labelledby="shop-story-title">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2 lg:gap-20">
      <div class="shop-portrait">
        <Image
          src={team}
          alt={
            es
              ? 'Dos miembros del equipo sonriendo durante un cambio de aceite'
              : 'Two team members smiling during an oil change'
          }
          class="team-photo aspect-square w-full object-cover"
          loading="lazy"
        />
        <Image
          src={shop}
          alt={es ? 'Entrada del taller de Rey’s' : 'Entrance to Rey’s workshop'}
          loading="lazy"
          class="shop-photo"
        />
        <p class="photo-caption">
          {es
            ? 'El equipo y el taller de Rey’s / Little Havana'
            : 'The people and place behind Rey’s / Little Havana'}
        </p>
      </div>
      <div>
        <p class="eyebrow">{es ? 'Bienvenido a Rey’s' : 'Welcome to Rey’s'}</p>
        <h2 id="shop-story-title" class="mt-4 text-h2">
          {es ? 'Tu taller en Little Havana.' : 'Your Little Havana workshop.'}
        </h2>
        <p class="mt-6 text-lg text-muted">
          {es
            ? 'Desde el mantenimiento de todos los días hasta el diagnóstico de esa luz en el tablero, conoce al equipo que cuida tu carro aquí en Little Havana.'
            : 'From everyday maintenance to figuring out that light on your dashboard, get to know the team caring for your car right here in Little Havana.'}
        </p>
        <p class="mt-4 text-muted">
          {es
            ? 'Carros alemanes, clásicos y tu vehículo de todos los días. Cuéntanos qué necesita tu carro y conversemos sobre el próximo paso.'
            : 'German cars, classics, and your everyday ride. Tell us what your car needs, and let’s talk through the next step.'}
        </p>
        <a href={pathFor(lang, 'about')} class="btn btn-secondary mt-8">
          {es ? 'Conócenos' : 'Get to know us'}
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .shop-portrait {
    position: relative;
    padding: 0 0 5rem;
    max-width: 530px;
  }
  .team-photo {
    width: 68%;
    max-width: 348px;
  }
  .shop-photo {
    position: absolute;
    right: 0;
    bottom: 2rem;
    width: 48%;
    max-width: 250px;
    aspect-ratio: 1;
    object-fit: cover;
    border: 8px solid white;
  }
  .photo-caption {
    margin-top: 1rem;
    font-size: 0.65rem;
    color: var(--color-muted);
    max-width: 55%;
    line-height: 1.5;
  }
</style>
