---
import type { Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const icons: IconName[] = ['star', 'german', 'classic', 'award'];
---

<section aria-label={t.trust.label} class="on-dark bg-ink text-cream">
  <ul class="container-x grid grid-cols-2 gap-x-4 gap-y-6 py-8 lg:grid-cols-4 lg:py-10">
    {
      t.trust.items.map((item, i) => (
        <li class="flex min-w-0 items-start gap-3">
          <span class="mt-0.5 inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-ink-2 text-brass">
            <Icon name={icons[i] ?? 'check'} class="size-5" />
          </span>
          <span class="min-w-0 [overflow-wrap:anywhere]">
            <span class="block leading-tight font-extrabold">{item.title}</span>
            <span class="mt-0.5 block text-sm text-mist">{item.text}</span>
          </span>
        </li>
      ))
    }
  </ul>
</section>
