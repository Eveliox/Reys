---
import { germanMakes } from '../config/site.ts';
import type { Lang } from '../i18n/routes.ts';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="container-x">
  <div class="makes-strip">
    <p>{lang === 'es' ? 'Especialistas en alemanes' : 'German vehicle specialists'}</p>
    <ul aria-label={lang === 'es' ? 'Marcas que atendemos' : 'Makes we service'}>
      {germanMakes.map((make) => (
        <li>{make}</li>
      ))}
    </ul>
  </div>
</div>
<style>
  .makes-strip {
    display: flex;
    align-items: center;
    gap: 3rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  p {
    max-width: 150px;
    font-size: 0.7rem;
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--color-muted);
  }
  ul {
    display: flex;
    flex: 1;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
    font-weight: 750;
  }
  @media (max-width: 767px) {
    .makes-strip {
      align-items: start;
      gap: 1.2rem;
      flex-direction: column;
    }
    p {
      max-width: none;
    }
    ul {
      justify-content: start;
      gap: 1rem 1.5rem;
      font-size: 0.95rem;
    }
  }
</style>
