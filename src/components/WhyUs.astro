---
import type { Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const icons: IconName[] = ['star', 'german', 'classic', 'shield'];
---

<section class="section bg-paper" aria-labelledby="why-title">
  <div class="container-x grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div class="lg:sticky lg:top-10 lg:self-start">
      <p class="eyebrow">{t.whyUs.eyebrow}</p>
      <h2 id="why-title" class="mt-3 text-h2">{t.whyUs.title}</h2>
    </div>
    <ol class="grid gap-x-8 gap-y-10 sm:grid-cols-2">
      {
        t.whyUs.items.map((item, i) => (
          <li class="border-t-2 border-ink pt-6">
            <div class="flex items-center justify-between">
              <span class="text-sm font-black tracking-widest text-accent tabular-nums" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <Icon name={icons[i] ?? 'check'} class="size-6 text-ink" />
            </div>
            <h3 class="mt-4 text-xl leading-tight tracking-tight [overflow-wrap:anywhere]">{item.title}</h3>
            <p class="mt-2 text-muted [overflow-wrap:anywhere]">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
