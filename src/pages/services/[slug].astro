---
import type { GetStaticPaths } from 'astro';
import ServicePage from '../../views/ServicePage.astro';
import { services } from '../../config/site.ts';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug.en }, props: { service } }))) satisfies GetStaticPaths;

const { service } = Astro.props;
---

<ServicePage lang="en" service={service} />
