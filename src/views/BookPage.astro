---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
import FridaySpecial from '../components/FridaySpecial.astro';
import type { Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} route="book" title={t.meta.book.title} description={t.meta.book.description}>
  <AppointmentForm lang={lang} headingLevel="h1" />
  <FridaySpecial lang={lang} />
</BaseLayout>
