---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import { autoRepairSchema, websiteSchema } from '../lib/schema.ts';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import FridaySpecial from '../components/FridaySpecial.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import WhyUs from '../components/WhyUs.astro';
import Reviews from '../components/Reviews.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
import LocationsSection from '../components/LocationsSection.astro';
import { locations } from '../config/site.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  route="home"
  title={t.meta.home.title}
  description={t.meta.home.description}
  jsonLd={[
    websiteSchema(lang),
    ...locations.map((l) => autoRepairSchema(l, lang, t.meta.home.description)),
  ]}
>
  <Hero lang={lang} />
  <TrustBar lang={lang} />
  <FridaySpecial lang={lang} />
  <ServiceGrid lang={lang} showAllLink />
  <WhyUs lang={lang} />
  <Reviews lang={lang} />
  <AppointmentForm lang={lang} />
  <LocationsSection lang={lang} />
</BaseLayout>
