---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import { websiteSchema } from '../lib/schema.ts';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import FridaySpecial from '../components/FridaySpecial.astro';
import ServiceGrid from '../components/ServiceGrid.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  route="home"
  title={t.meta.home.title}
  description={t.meta.home.description}
  jsonLd={[websiteSchema(lang)]}
>
  <Hero lang={lang} />
  <TrustBar lang={lang} />
  <FridaySpecial lang={lang} />
  <ServiceGrid lang={lang} showAllLink />
</BaseLayout>
