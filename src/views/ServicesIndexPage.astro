---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import FridaySpecial from '../components/FridaySpecial.astro';
import Icon from '../components/Icon.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import { services } from '../config/site.ts';
import { pathFor, type Lang } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/utils.ts';
import { breadcrumbSchema } from '../lib/schema.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const crumbs = [
  { name: t.breadcrumb.home, path: pathFor(lang, 'home') },
  { name: t.services.breadcrumb, path: pathFor(lang, 'services') },
];
---

<BaseLayout
  lang={lang}
  route="services"
  title={t.meta.services.title}
  description={t.meta.services.description}
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs lang={lang} items={crumbs} />
  <header class="container-x pt-8 pb-12 lg:pt-12">
    <p class="eyebrow">{t.services.eyebrow}</p>
    <h1 class="mt-4 max-w-4xl text-display">{t.services.title}</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">{t.services.intro}</p>
  </header>
  <ServiceGrid lang={lang} showHeader={false} />
  <section class="section bg-paper" aria-labelledby="full-list-title">
    <div class="container-x">
      <h2 id="full-list-title" class="text-h2">
        {t.services.fullListTitle}
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-muted">{t.services.fullListIntro}</p>
      <div class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <div>
            <h3 class="flex items-center gap-2 text-lg tracking-tight">
              <Icon name={s.icon} class="size-5 shrink-0 text-accent" />
              <a href={pathFor(lang, { service: s.id })} class="hover:text-accent">
                {t.services.items[s.id].name}
              </a>
            </h3>
            <ul class="mt-3 space-y-1.5 border-t border-line pt-3 text-muted">
              {t.services.items[s.id].includes.map((item) => (
                <li class="flex gap-2">
                  <Icon name="check" class="mt-1 size-4 shrink-0 text-accent" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  <FridaySpecial lang={lang} />
  <CTASection lang={lang} />
</BaseLayout>
